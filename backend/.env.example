# ============================================================================
# WorkContext Backend — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/workcontext

# ----------------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# AUTHENTICATION (Supabase)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# AI PROVIDERS (at least one required)
# ----------------------------------------------------------------------------

# OpenAI (GPT-4o, GPT-4o-mini, o1, etc.)
OPENAI_API_KEY=sk-...

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus, etc.)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI (Gemini 1.5 Pro, Gemini 1.5 Flash, etc.)
GOOGLE_AI_API_KEY=...

# Mistral AI (Mistral Large, Mistral Small, etc.)
MISTRAL_API_KEY=...

# OpenRouter (access to all models via single API)
OPENROUTER_API_KEY=sk-or-...

# Perplexity (Sonar models for web-grounded search)
PERPLEXITY_API_KEY=pplx-...

# Google Search (for web search feature)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ----------------------------------------------------------------------------
# ENCRYPTION
# ----------------------------------------------------------------------------
# KEEP THIS SECRET - losing it means all stored API keys become unreadable
ENCRYPTION_MASTER_KEY=your-encryption-master-key-here

# --- AI Service Keys ---
# BYOK ONLY: Users add their own API keys via Settings > AI API Keys.
# The backend does NOT use any AI keys from this file.
# All AI functionality requires the user to configure their own keys.

# ----------------------------------------------------------------------------
# EMAIL SERVICE (Plunk)
# ----------------------------------------------------------------------------
# Use Secret API Key, NOT Public API Key
PLUNK_API_KEY=sk_...

# ----------------------------------------------------------------------------
# MARKETING EMAIL (EmailOctopus)
# ----------------------------------------------------------------------------
EMAILOCTOPUS_API_KEY=your_emailoctopus_api_key
EMAILOCTOPUS_LIST_ID=your_emailoctopus_list_id

# ----------------------------------------------------------------------------
# SMS (Twilio) — optional
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_MESSAGE_SERVICE_SID=your_message_service_sid

# ----------------------------------------------------------------------------
# PAYMENTS (LemonSqueezy) — optional
# ----------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_key

# ----------------------------------------------------------------------------
# CRON JOB
# ----------------------------------------------------------------------------
# Generate a random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_JOB_SECRET=your_cron_secret_here

# ----------------------------------------------------------------------------
# UNSPLASH (image search)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_UNSPLASH_API_URL=https://api.unsplash.com
NEXT_PUBLIC_UNSPLASH_REDIRECT_URL=urn:ietf:wg:oauth:2.0:oob
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=your_access_key
NEXT_PUBLIC_UNSPLASH_SECRET_KEY=your_secret_key
NEXT_PUBLIC_UNSPLASH_APPLICATION_ID=your_application_id

# ----------------------------------------------------------------------------
# INTEGRATIONS — Slack
# Create at: https://api.slack.com/apps
# Bot scopes: channels:history, channels:read, files:read, users:read, groups:history, im:history, mpim:history
# User scopes: channels:history, channels:read, files:read, users:read, search:read, groups:history, im:history, mpim:history
# NOTE: search:read is a User Token Scope only — it must never be requested as a bot scope.
# ----------------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# INTEGRATIONS — Notion
# Create at: https://www.notion.so/my-integrations
# Required capabilities: Read content, Read comments
# ----------------------------------------------------------------------------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# INTEGRATIONS — Jira (Atlassian)
# Create at: https://developer.atlassian.com/console/myapps/
# Required scopes: read:jira-work, read:jira-user, offline_access
# ----------------------------------------------------------------------------
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# INTEGRATIONS — GitHub (OAuth App)
# Create at: https://github.com/settings/developers → OAuth Apps
# Required scopes: read:user, repo, read:org
# Callback URL: http://localhost:3001/api/integrations/callback
# ----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# INTEGRATIONS — GitHub App (Enterprise-grade)
# Create at: https://github.com/settings/apps/new
# Permissions: Contents (read), Issues (read), Pull requests (read)
# Events: Push, Issues, Pull request
# Install URL: https://github.com/apps/{slug}/installations/new
# Callback URL: http://localhost:3001/api/integrations/github/installation/callback
# ----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=

# ----------------------------------------------------------------------------
# INTEGRATIONS — Figma
# Create at: https://www.figma.com/developers/apps
# Required scopes: file_read, project_read
# ----------------------------------------------------------------------------
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------------------
# REAL-TIME (Hocuspocus)
# ----------------------------------------------------------------------------
# Default ports work for local dev. Change for production.
HOCUSPOCUS_PORT=9081

# ----------------------------------------------------------------------------
# SENTRY (Error monitoring)
# ----------------------------------------------------------------------------
# Read server-side by sentry.server.config.ts, sentry.edge.config.ts and
# src/instrumentation-client.ts. Leave unset to disable Sentry entirely.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional: only needed to upload source maps during CI/deploy builds.
# SENTRY_AUTH_TOKEN=sntr_...
# SENTRY_ORG=audiquity-impact
# SENTRY_PROJECT=javascript-nextjs
